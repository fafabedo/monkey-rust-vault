# ─── Supabase ────────────────────────────────────────────────────────────────
# Supabase → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# Supabase → Project Settings → API → JWT Secret  (required in prod/staging)
SUPABASE_JWT_SECRET=your-jwt-secret

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Set to true for local dev only — skips JWT validation and permission checks.
# Must be false (or unset) in staging and production.
AUTH_BYPASS=false

# ─── Encryption ──────────────────────────────────────────────────────────────
# 32-byte (256-bit) hex key for AES-256-GCM credential encryption.
# Generate with:  openssl rand -hex 32
VAULT_ENCRYPTION_KEY=<32-byte-hex-key>

# ─── AWS (default fallback; per-bucket credentials live in the DB) ────────────
AWS_DEFAULT_REGION=ca-central-1


# ─── Server ──────────────────────────────────────────────────────────────────
BIND_ADDR=127.0.0.1:4200
RUST_LOG=monkey_vault=debug,tower_http=debug
